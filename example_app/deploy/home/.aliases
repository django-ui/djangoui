alias ll="ls -l"
alias la="ls -a"
alias ls="ls -F"
alias gmake=make
alias xterm='xterm -bg black -fg khaki -sb -sl 10000 -tn xterm -n "KSH-xterm" -vb &'
alias ifc="ifconfig | grep netmask"
alias tags="find . -name "*.[chCH]" -print | etags -"
alias rm='rm -i';
alias cp='cp -iP';
alias mv='mv -i';
alias grep='grep -sHn'
alias ssh1='ssh snarayan@linux1.cs.du.edu'

alias ipy='ipython notebook --pylab=inline'
alias ipy='jupyter-notebook --notebook-dir=~/git/DS'

alias gitp='git pull'
alias gitr='git remote show origin'
alias gitpu='git push'
alias gitc='git commit -a -m "Changes added"'
alias gitcp='gitc; git push'
alias gitco='git checkout'
alias gitb='git branch'
alias gits='git status'
alias gita='git add'
alias cdg='cd ~/git/DS/'

alias py312='source ~/venv/py312/bin/activate'

